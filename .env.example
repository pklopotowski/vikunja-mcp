# Vikunja MCP Server Configuration
# Copy this file to .env and fill in your values

# Required: Base URL of your Vikunja instance
# Example: https://vikunja.example.com or http://localhost:3456
VIKUNJA_URL=

# Required: Shared secret that clients (e.g. nanobot) must send as
# `Authorization: Bearer <token>` to authenticate against this MCP server.
# Generate a strong random value, e.g.: openssl rand -hex 32
VIKUNJA_MCP_TOKEN=

# Optional: HTTP server bind address (default: 0.0.0.0)
HOST=

# Optional: HTTP server port (default: 3000)
PORT=

# Note: The Vikunja API token is NOT configured here.
# Each request must carry it as an `X-Vikunja-Token: <vikunja-api-token>` header.
# See README.md for client (nanobot) configuration examples.
